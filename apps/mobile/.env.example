# The site and API origin the app talks to: staging, or your Mac's LAN address with `pnpm --filter web dev` running.
# Never production: dev builds add and delete tags, and those must never reach the live counts.
EXPO_PUBLIC_SERVER_URL=https://mymeetingapp-staging.vercel.app

# Android's Google Maps key, for local Android builds only (EAS builds read it from EAS). Never commit it: see docs/mobile.md, "Android builds".
GOOGLE_MAPS_ANDROID_API_KEY=
