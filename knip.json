{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {},
    "packages/*": {
      "project": ["src/**/*.ts!", "test/**/*.ts"]
    },
    "packages/test-server": {
      "project": ["src/**/*.ts"],
      "includeEntryExports": false
    },
    "tools/*": {
      "project": ["src/**/*.ts!", "test/**/*.ts"],
      "includeEntryExports": false
    },
    "apps/web": {
      "entry": ["scripts/*.ts!", "test/*.e2e.ts"],
      "project": ["src/**/*.{ts,tsx}!", "scripts/**/*.ts!", "test/**/*.{ts,tsx}", "*.ts"]
    },
    "apps/mobile": {
      "entry": ["test/native/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}!", "modules/*/index.ts!", "test/**/*.{ts,tsx}", "*.{ts,js}"],
      "ignoreDependencies": ["@expo-google-fonts/atkinson-hyperlegible"]
    }
  }
}
