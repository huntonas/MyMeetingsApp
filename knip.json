{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {},
    "packages/*": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "apps/web": {
      "project": ["src/**/*.{ts,tsx}", "test/**/*.ts", "scripts/**/*.ts", "*.ts"]
    }
  }
}
