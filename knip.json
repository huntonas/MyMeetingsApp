{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {},
    "packages/*": {
      "project": ["src/**/*.ts!", "test/**/*.ts"]
    },
    "packages/test-server": {
      "project": ["src/**/*.ts"],
      "includeEntryExports": false
    },
    "tools/*": {
      "project": ["src/**/*.ts!", "test/**/*.ts"]
    },
    "apps/web": {
      "entry": ["scripts/*.ts!"],
      "project": ["src/**/*.{ts,tsx}!", "scripts/**/*.ts!", "test/**/*.ts", "*.ts"]
    }
  }
}
